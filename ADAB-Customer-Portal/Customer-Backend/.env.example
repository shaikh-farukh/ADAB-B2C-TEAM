PORT=5002
DATABASE_URL=postgresql://your_user:your_password@your_host:5432/your_db?sslmode=require
DB_HOST=your_host_here
DB_PORT=5432
DB_USER=your_user_here
DB_PASSWORD=your_password_here
DB_NAME=your_db_here
DB_SSL_MODE=require
JWT_SECRET=your_jwt_secret_here

# Razorpay Test Mode Configuration
# Obtain test credentials from Razorpay Dashboard: Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_test_webhook_secret_here
PAYMENT_GATEWAY_PROVIDER=razorpay
