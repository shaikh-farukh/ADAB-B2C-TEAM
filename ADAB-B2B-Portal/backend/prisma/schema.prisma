model manage_b_to_b_vehicle_routes {
  id                     Int                     @id @default(autoincrement())
  owner_id               Int?
  vehicle_id             Int?
  driver_id              Int?
  order_id               Int?
  route_name             String?                 @db.VarChar(255)
  source_location        String?                 @db.VarChar(255)
  destination_location   String?                 @db.VarChar(255)
  waypoints              Json?
  estimated_distance_km  Decimal?                @db.Decimal(8, 2)
  estimated_time_hours   Decimal?                @db.Decimal(6, 2)
  status                 String?                 @default("SCHEDULED") @db.VarChar(50)
  created_at             DateTime?               @default(now()) @db.Timestamp(6)
  deleted_at             DateTime?               @db.Timestamp(6)
  manage_b_to_b_drivers  manage_b_to_b_drivers?  @relation(fields: [driver_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  manage_b_to_b_orders   manage_b_to_b_orders?   @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  manage_b_to_b_vehicles manage_b_to_b_vehicles? @relation(fields: [vehicle_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model manage_b_to_b_vehicles {
  id                                Int                                @id @default(autoincrement())
  owner_id                          Int?
  logistics_provider_id             Int?
  driver_id                         Int?
  vehicle_number                    String?                            @db.VarChar(100)
  vehicle_type                      String?                            @db.VarChar(100)
  capacity                          String?                            @db.VarChar(100)
  insurance_expiry_date             DateTime?                          @db.Date
